# Copy this file to .env and fill in your own values. .env is never pushed to GitHub.
# Testnet keys: log in at https://testnet.binance.vision with GitHub and press "Generate HMAC_SHA256 Key".
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

CTE_MODE=replay              # replay or live
CTE_SYMBOLS=BTCUSDT          # comma-separated, e.g. BTCUSDT,ETHUSDT
CTE_PLUGIN_KEYS=demo-plugin-key   # keys other teams send in X-API-Key to place orders
CTE_CORS_ORIGINS=*           # web pages allowed to call the API from a browser
