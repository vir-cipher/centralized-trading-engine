{
  "openapi": "3.1.0",
  "info": {
    "title": "Centralized Trading Engine",
    "description": "A gateway to the Binance Spot Testnet (practice market, toy money). It listens to live trades, cleans them, stores them, gives BUY/SELL/HOLD advice from two moving averages, and forwards signed orders.\n\n**Reading is open. Placing or cancelling an order needs `X-API-Key`.**\n\nEvery error has the shape `{\"error\": {\"code\", \"message\"}}`. Guide for plugin builders: `plugin/INTEGRATE_IN_15_MIN.md` in the repository.",
    "version": "1.1.0"
  },
  "paths": {
    "/trace": {
      "get": {
        "tags": [
          "status"
        ],
        "summary": "The engine's own call log: newest lines after `after`",
        "description": "Lines like a terminal: every API call in, every Binance call out. Secrets are masked.",
        "operationId": "get_trace_trace_get",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "After"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "status"
        ],
        "summary": "Is the engine running, and in which mode?",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/prices/{symbol}": {
      "get": {
        "tags": [
          "market"
        ],
        "summary": "Latest price of one symbol",
        "operationId": "get_price_prices__symbol__get",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Symbol"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Price"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/trades": {
      "get": {
        "tags": [
          "market"
        ],
        "summary": "Most recent clean trades",
        "operationId": "get_trades_trades_get",
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "BTCUSDT",
              "title": "Symbol"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Trade"
                  },
                  "title": "Response Get Trades Trades Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/candles": {
      "get": {
        "tags": [
          "market"
        ],
        "summary": "One-minute candles, oldest first",
        "operationId": "get_candles_candles_get",
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "BTCUSDT",
              "title": "Symbol"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1440,
              "minimum": 1,
              "default": 60,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Candle"
                  },
                  "title": "Response Get Candles Candles Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/signals/{symbol}": {
      "get": {
        "tags": [
          "signal"
        ],
        "summary": "BUY / SELL / HOLD advice (advisory only)",
        "operationId": "get_signal_signals__symbol__get",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Symbol"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Signal"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/account/balance": {
      "get": {
        "tags": [
          "account"
        ],
        "summary": "Testnet balances (toy money)",
        "operationId": "get_balance_account_balance_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Balance"
                  },
                  "type": "array",
                  "title": "Response Get Balance Account Balance Get"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "get": {
        "tags": [
          "orders"
        ],
        "summary": "Orders placed through this engine",
        "operationId": "get_orders_orders_get",
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Symbol"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  },
                  "title": "Response Get Orders Orders Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "orders"
        ],
        "summary": "Place a MARKET or LIMIT order (signed with HMAC-SHA256 before it leaves the laptop)",
        "operationId": "post_order_orders_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "plugin key, required for orders",
              "title": "X-Api-Key"
            },
            "description": "plugin key, required for orders"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{order_id}": {
      "delete": {
        "tags": [
          "orders"
        ],
        "summary": "Cancel an order that is still open (NEW). Cancelling does not undo a fill.",
        "operationId": "delete_order_orders__order_id__delete",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Order Id"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "plugin key, required for orders",
              "title": "X-Api-Key"
            },
            "description": "plugin key, required for orders"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not Found"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Balance": {
        "properties": {
          "asset": {
            "type": "string",
            "title": "Asset"
          },
          "free": {
            "type": "number",
            "title": "Free"
          },
          "locked": {
            "type": "number",
            "title": "Locked"
          }
        },
        "type": "object",
        "required": [
          "asset",
          "free",
          "locked"
        ],
        "title": "Balance"
      },
      "Candle": {
        "properties": {
          "minute_start_ms": {
            "type": "integer",
            "title": "Minute Start Ms"
          },
          "open": {
            "type": "number",
            "title": "Open"
          },
          "high": {
            "type": "number",
            "title": "High"
          },
          "low": {
            "type": "number",
            "title": "Low"
          },
          "close": {
            "type": "number",
            "title": "Close"
          },
          "volume": {
            "type": "number",
            "title": "Volume"
          }
        },
        "type": "object",
        "required": [
          "minute_start_ms",
          "open",
          "high",
          "low",
          "close",
          "volume"
        ],
        "title": "Candle"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "examples": [
              "NOT_FOUND"
            ]
          },
          "message": {
            "type": "string",
            "title": "Message",
            "examples": [
              "no data yet for ETHUSDT"
            ]
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorOut": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Order": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "client_id": {
            "type": "string",
            "title": "Client Id"
          },
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "side": {
            "type": "string",
            "title": "Side"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "qty": {
            "type": "number",
            "title": "Qty"
          },
          "price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "NEW, FILLED, PARTIALLY_FILLED, CANCELED, REJECTED",
            "examples": [
              "FILLED"
            ]
          },
          "exchange_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exchange Id"
          },
          "filled_price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filled Price"
          },
          "created_ms": {
            "type": "integer",
            "title": "Created Ms"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "id",
          "client_id",
          "symbol",
          "side",
          "type",
          "qty",
          "price",
          "status",
          "exchange_id",
          "filled_price",
          "created_ms",
          "note"
        ],
        "title": "Order"
      },
      "OrderIn": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol",
            "examples": [
              "BTCUSDT"
            ]
          },
          "side": {
            "type": "string",
            "enum": [
              "BUY",
              "SELL"
            ],
            "title": "Side",
            "examples": [
              "BUY"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "MARKET",
              "LIMIT"
            ],
            "title": "Type",
            "examples": [
              "MARKET"
            ]
          },
          "qty": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Qty",
            "examples": [
              0.001
            ]
          },
          "price": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Price",
            "description": "required for LIMIT, ignored for MARKET"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "side",
          "type",
          "qty"
        ],
        "title": "OrderIn"
      },
      "Price": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol",
            "examples": [
              "BTCUSDT"
            ]
          },
          "price": {
            "type": "number",
            "title": "Price",
            "description": "latest known price",
            "examples": [
              67012.5
            ]
          },
          "ts": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ts",
            "description": "time of that price, ms since 1970 UTC",
            "examples": [
              1795301234567
            ]
          },
          "source": {
            "type": "string",
            "title": "Source",
            "description": "LIVE (Binance Testnet) or REPLAY (recorded data)",
            "examples": [
              "REPLAY"
            ]
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "price",
          "source"
        ],
        "title": "Price"
      },
      "Signal": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol",
            "examples": [
              "BTCUSDT"
            ]
          },
          "advice": {
            "type": "string",
            "enum": [
              "BUY",
              "SELL",
              "HOLD"
            ],
            "title": "Advice",
            "examples": [
              "HOLD"
            ]
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "examples": [
              "no fresh crossing this minute"
            ]
          },
          "short_now": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Short Now"
          },
          "long_now": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Long Now"
          },
          "short_window": {
            "type": "integer",
            "title": "Short Window",
            "examples": [
              5
            ]
          },
          "long_window": {
            "type": "integer",
            "title": "Long Window",
            "examples": [
              15
            ]
          },
          "honest_test": {
            "additionalProperties": true,
            "type": "object",
            "title": "Honest Test",
            "description": "rule vs baseline accuracy on later minutes only"
          },
          "advisory_only": {
            "type": "boolean",
            "title": "Advisory Only",
            "description": "the engine never places an order by itself",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "advice",
          "reason",
          "short_window",
          "long_window",
          "honest_test"
        ],
        "title": "Signal"
      },
      "Trade": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "trade_id": {
            "type": "integer",
            "title": "Trade Id"
          },
          "price": {
            "type": "number",
            "title": "Price"
          },
          "qty": {
            "type": "number",
            "title": "Qty"
          },
          "ts": {
            "type": "integer",
            "title": "Ts"
          },
          "source": {
            "type": "string",
            "title": "Source"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "trade_id",
          "price",
          "qty",
          "ts",
          "source"
        ],
        "title": "Trade"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
